{
  "name": "DiagnosticRun",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string"
    },
    "symptom_id": {
      "type": "string"
    },
    "symptom_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "resolved",
        "unresolved"
      ],
      "default": "in_progress"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          }
        }
      }
    },
    "findings": {
      "type": "string"
    },
    "conclusion": {
      "type": "string"
    }
  },
  "required": [
    "vehicle_id",
    "symptom_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}