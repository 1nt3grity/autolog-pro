{
  "name": "UserSettings",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "email_reminders_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}